{
  "name": "rest-node-express-nest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:node": "turbo dev --filter=\"./node/*\"",
    "dev:express": "turbo dev --filter=\"./express/*\"",
    "dev:nest": "turbo dev --filter=\"./nest/*\"",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
