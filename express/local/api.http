@baseUrl = http://localhost:3201
@path = tasks
@existingId=be7a9b6d-a0f8-44bc-9f51-83b722b836da
@updatedId=497f673f-085a-46a1-87ed-5bb42e29c0ef
@deletedId=write here id for task to be deleted

### List tasks
GET {{baseUrl}}/{{path}}

### Get task by id → 200
GET {{baseUrl}}/{{path}}/{{existingId}}

### Get task: missing id
GET {{baseUrl}}/{{path}}/1

### Create a new task
POST {{baseUrl}}/{{path}}
Content-Type: application/json

{
  "title": "New task",
  "isCompleted": true
}

### Update a task
PATCH  {{baseUrl}}/{{path}}/{{updatedId}}
Content-Type: application/json

{
"isCompleted": true
}

### Delete a task
DELETE  {{baseUrl}}/{{path}}/{{deletedId}}
